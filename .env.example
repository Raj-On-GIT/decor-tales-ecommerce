# Django
SECRET_KEY=your-django-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - either DATABASE_URL (preferred) or the individual DB_* variables
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
# DB_NAME=database_name
# DB_USER=username
# DB_PASSWORD=password
# DB_HOST=hostname
# DB_PORT=5432

# Cloudinary (media storage) - either CLOUDINARY_URL or the split credentials
USE_CLOUDINARY=True
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=cloud_name
# CLOUDINARY_API_KEY=api_key
# CLOUDINARY_API_SECRET=api_secret

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="DecorTales <noreply@decortalesshop.com>"
# RESEND_API_URL=https://api.resend.com/emails

GOOGLE_CLIENT_ID=your-google-client-id

# Auth cookies
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_DOMAIN=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Delhivery shipping
DELHIVERY_BASE_URL=
DELHIVERY_API_KEY=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_ORIGIN_PIN=110077
DELHIVERY_WEBHOOK_SECRET=

# Optional tuning (defaults shown)
# SIGNUP_OTP_EXPIRY_SECONDS=300
# SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
# SIGNUP_OTP_MAX_VERIFY_ATTEMPTS=5
# SIGNUP_OTP_MAX_SENDS=5
# PAYMENT_RESERVATION_MINUTES=15
# ORDER_CUSTOMIZATION_MEDIA_RETENTION_DAYS=7
# ALLOW_LEGACY_DIRECT_ORDER=False

# Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_your_key_id
